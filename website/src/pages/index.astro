---
import '../styles/global.css';
const github = 'https://github.com/sidneykanoti/LNMTLWebToEbook';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Save your favourite LNMTL novels as EPUB, PDF, or HTML. Free desktop software for Windows, macOS, and Linux. Download, open, and read offline." />
    <meta name="theme-color" content="#123f36" />
    <title>LNMTL Web to Ebook — A little more offline.</title>
    <link rel="icon" href="/app-icon.png" />
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href="#" aria-label="LNMTL Web to Ebook home"><img src="/app-icon.png" alt="" width="40" height="40" /><span>LNMTL <small>Web to Ebook</small></span></a>
      <nav aria-label="Main navigation"><a href="#how-it-works">How it works</a><a href="#questions">FAQs</a><a class="nav-download" href="#download">Get the app <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main>
      <section class="hero wrap">
        <div class="hero-copy"><p class="eyebrow"><span class="dot"></span> FOR THE ONE-MORE-CHAPTER READER</p><h1>Your next chapter.<br /><em>Anywhere.</em></h1><p class="intro">Give your favourite LNMTL novels a home on your device. Save chapters, make ebooks, and settle in for a little more offline.</p><a class="button" id="hero-download" href="#download">Get the free app <span aria-hidden="true">↓</span></a><p class="micro">Windows, macOS & Linux · Free to use</p></div>
        <div class="book-scene" aria-label="EPUB, PDF and HTML books for offline reading"><div class="scene-ring"></div><span class="scene-note">Your library. Your pace.</span><div class="book book-back"><span>THE OFFLINE<br />COLLECTION</span><i>HTML · PDF</i></div><div class="book book-front"><span class="book-top">LNMTL / YOUR PERSONAL LIBRARY</span><div class="book-line"></div><strong>Just one<br />more<br /><em>chapter.</em></strong><span class="book-bottom">SAVED FOR A QUIETER MOMENT<br /><b>EPUB / PDF / HTML</b></span></div><span class="scene-caption">A whole world, within reach.</span></div>
      </section>
      <div class="format-strip"><div class="wrap"><span>Made for your reading ritual</span><span>EPUB <i>For your ebook reader</i></span><span>PDF <i>For familiar pages</i></span><span>HTML <i>For your browser</i></span></div></div>
      <section class="showcase wrap" id="inside"><div class="section-heading"><div><p class="eyebrow">A SMALL APP. A BIG READING LIST.</p><h2>Less setup.<br /><em>More story.</em></h2></div><p>One place to find novels, save your chapters, and turn them into books. Your library and download progress stay on your computer.</p></div><div class="app-frame"><div class="frame-bar"><span><i></i><i></i><i></i></span><span>LNMTL Web to Ebook</span><span>DESKTOP APP</span></div><a href="/app-screenshot.png" target="_blank" rel="noopener" aria-label="Open full-size app screenshot"><img src="/app-screenshot.png" alt="LNMTL Web to Ebook desktop app with novel catalogue, search, download controls and EPUB, PDF and HTML export options" width="1327" height="990" loading="lazy" /></a></div><div class="feature-row"><div><span>01 / KEEP YOUR PLACE</span><h3>Pick up where you left off.</h3><p>Pause and resume downloads. Chapters already saved stay saved, even after you close the app.</p></div><div><span>02 / READ YOUR WAY</span><h3>A book in your favourite format.</h3><p>Export EPUB, PDF, or HTML. Keep the familiar light reading style, with chapter contents and volume headings.</p></div><div><span>03 / KEEP IT CLOSE</span><h3>Your library lives with you.</h3><p>Choose your library folder, keep your books locally, and read offline. No account or cloud upload required.</p></div></div></section>
      <section class="steps-section" id="how-it-works"><div class="wrap steps-layout"><div><p class="eyebrow">FROM LINK TO LIBRARY</p><h2>Three steps.<br /><em>Then get lost.</em></h2><p>In a good book, of course.</p></div><ol class="steps"><li><span>01</span><div><h3>Download and open.</h3><p>Choose the app for your computer. Everything you need to run the app is bundled in the release.</p></div></li><li><span>02</span><div><h3>Find your next read.</h3><p>Paste a novel link or short name. Or click <b>Load catalogue</b> to list all LNMTL novels, then search for the one you want.</p></div></li><li><span>03</span><div><h3>Save it. Make it a book.</h3><p>Select your novel and click <b>Download / resume selected</b>. Choose your format, then <b>Export selected</b>.</p><p class="tip">A little tip: Sample first saves three new chapters per run. Turn it off to download all remaining chapters.</p></div></li></ol></div></section>
      <section class="download-section wrap" id="download"><p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p><h2>Make room for<br /><em>a little more offline.</em></h2><p>Free to use. Choose your computer below.</p><p id="download-error" role="alert" hidden>We couldn’t get the latest download right now. Please try again or <a href={`${github}/releases/latest`}>download from GitHub Releases</a>.</p><div class="downloads"><article data-os="windows"><span class="os-symbol" aria-hidden="true">⊞</span><h3>Windows</h3><p>Windows · 64-bit</p><a class="button" href="/download/windows">Download for Windows <span aria-hidden="true">↓</span></a><small>Open the .exe to get started.</small></article><article data-os="mac"><span class="os-symbol" aria-hidden="true">⌘</span><h3>macOS</h3><p>Choose your Mac’s chip</p><a class="button" href="/download/mac-arm">Apple Silicon <span aria-hidden="true">↓</span></a><a class="secondary-download" href="/download/mac-intel">Download for Intel Mac ↓</a><small>Find your chip in About This Mac.</small></article><article data-os="linux"><span class="os-symbol" aria-hidden="true">&gt;_</span><h3>Linux</h3><p>Ubuntu 24.04+ · 64-bit</p><a class="button" href="/download/linux">Download for Linux <span aria-hidden="true">↓</span></a><a class="secondary-download" href="/download/linux-deb">Prefer a .deb package? ↓</a><small>Extract the archive and open the app.</small></article></div><p class="release-note">Always the latest release, directly from GitHub. <a href={`${github}/releases`}>View release notes ↗</a></p></section>
      <section class="faq wrap" id="questions"><div><p class="eyebrow">BEFORE YOU TURN THE PAGE</p><h2>A few good<br /><em>questions.</em></h2></div><div class="faq-list"><details><summary>Is it really free?</summary><p>Yes. All features are free to use. If the app becomes part of your reading routine, you can optionally <a href="https://www.paypal.biz/omnipotentcore">support the project</a>.</p></details><details><summary>Do I need Python or other software?</summary><p>No. Download a packaged release for your computer. Python and the PDF engine are included. See the <a href={`${github}/blob/main/docs/USER_GUIDE.md`}>user guide</a> for platform-specific help.</p></details><details><summary>Why did it only download three chapters?</summary><p>Sample first is enabled by default. Uncheck it, then click Download / resume selected to save all remaining indexed chapters.</p></details><details><summary>Can I continue a download later?</summary><p>Yes. Your progress is kept locally. Reopen the app and resume; chapters already saved are skipped. Refresh the novel index to find newly available chapters.</p></details><details><summary>What if my computer shows a security prompt?</summary><p>The releases are not currently signed or notarized, so your operating system may show a warning. Read the <a href={`${github}/blob/main/PACKAGING.md`}>platform instructions</a> before opening the app if you encounter a prompt.</p></details><details><summary>Does it translate novels or work without internet?</summary><p>The app saves available English chapters from LNMTL; it does not translate new text. You need internet to find and download chapters. Once exported, your books can be read offline.</p></details></div></section>
      <section class="support wrap"><div><p class="eyebrow">BUILT FOR READERS</p><h3>Enjoying your offline library?</h3><p>A little support helps this independent project keep going.</p></div><a class="outline-button" href="https://www.paypal.biz/omnipotentcore" target="_blank" rel="noopener">Support the project <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="wrap"><a class="brand" href="#"><img src="/app-icon.png" width="32" height="32" alt="" /><span>LNMTL <small>Web to Ebook</small></span></a><p>An independent project by Sidney Kanoti.<br />Not affiliated with LNMTL. Software licensed under GPL-3.0-only.</p><div><a href={github}>GitHub ↗</a><a href={`${github}/blob/main/docs/USER_GUIDE.md`}>User guide ↗</a></div></footer>
    <script>
      const platform = navigator.userAgent.toLowerCase();
      const os = /android|iphone|ipad/.test(platform) ? null : /win/.test(platform) ? 'windows' : /mac/.test(platform) ? 'mac' : /linux/.test(platform) ? 'linux' : null;
      if (os) {
        const card = document.querySelector(`[data-os="${os}"]`);
        card?.classList.add('recommended');
        const badge = document.createElement('span'); badge.className = 'recommended-label'; badge.textContent = 'FOR YOUR COMPUTER'; card?.prepend(badge);
        const button = document.querySelector<HTMLAnchorElement>('#hero-download');
        if (button) { button.textContent = os === 'mac' ? 'Choose your Mac download ↓' : `Download for ${os === 'windows' ? 'Windows' : 'Linux'} ↓`; button.href = os === 'mac' ? '#download' : `/download/${os}`; }
      }
      if (new URLSearchParams(location.search).has('download')) document.querySelector('#download-error')?.removeAttribute('hidden');
    </script>
  </body>
</html>
